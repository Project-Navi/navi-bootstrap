{%- set pkg = spec.name | replace('-', '_') -%}
{%- set pv = spec.python_version | default("3.12") -%}
{%- set tst = spec.structure.test_dir | default("tests") if spec.structure is defined else "tests" -%}
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ spec.name }}"
version = "{{ spec.version | default('0.1.0') }}"
description = "{{ spec.description | default('') }}"
requires-python = ">={{ pv }}"
{% if spec.license is defined -%}
license = "{{ spec.license }}"
{% endif -%}
{% if spec.author is defined -%}
authors = [
    { name = "{{ spec.author.name }}"{% if spec.author.email is defined %}, email = "{{ spec.author.email }}"{% endif %} },
]
{% endif -%}
readme = "README.md"
{% if spec.dependencies is defined and spec.dependencies.runtime is defined and spec.dependencies.runtime -%}
dependencies = [
{% for dep in spec.dependencies.runtime %}    "{{ dep }}",
{% endfor %}]
{% else -%}
dependencies = []
{% endif %}
{%- set _base_dev = ["pytest", "pytest-cov", "ruff", "mypy"] -%}
[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=5.0",
    "ruff>=0.4",
    "mypy>=1.10",
{% if spec.dependencies is defined and spec.dependencies.dev is defined -%}
{% for dep in spec.dependencies.dev -%}
{%- set dep_base = dep.split('>')[0].split('<')[0].split('=')[0].split('!')[0].split('[')[0] -%}
{% if dep_base not in _base_dev %}    "{{ dep }}",
{% endif -%}
{% endfor -%}
{% endif -%}
]

[tool.pytest.ini_options]
testpaths = ["{{ tst }}"]

[tool.ruff]
line-length = 100
target-version = "py{{ pv | replace('.', '') }}"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "RUF", "C4"]

[tool.mypy]
python_version = "{{ pv }}"
strict = true
